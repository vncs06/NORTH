{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "incremental": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@north/domain": ["packages/domain/src/index.ts"],
      "@north/domain/commercial": ["packages/domain/src/commercial.ts"],
      "@north/application": ["packages/application/src/index.ts"],
      "@north/database": ["packages/database/src/index.ts"],
      "@north/auth": ["packages/auth/src/index.ts"],
      "@north/contracts": ["packages/contracts/src/index.ts"],
      "@north/observability": ["packages/observability/src/index.ts"],
      "@north/testing": ["packages/testing/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "e2e/**/*.ts", "*.ts"],
  "exclude": ["node_modules", ".next", "dist", "packages/database/src/generated"]
}
