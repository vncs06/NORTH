  status                       String
  version                      Int
  pricingPolicyId              String?   @map("pricing_policy_id") @db.Uuid
  discountPolicyId             String?   @map("discount_policy_id") @db.Uuid
  pricingMethod                String?   @map("pricing_method")
  pricingRateBps               Int?      @map("pricing_rate_bps")
  discountBps                  Int?      @map("discount_bps")
  materialCostCents            BigInt?   @map("material_cost_cents")
  additionalCostCents          BigInt?   @map("additional_cost_cents")
  costBaseCents                BigInt?   @map("cost_base_cents")
