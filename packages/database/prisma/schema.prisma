generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model Installation {
  singletonKey Boolean  @id @default(true) @map("singleton_key")
  id           String   @unique @db.Uuid
  companyName  String   @map("company_name")
  timezone     String
  currency     String
  createdAt    DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @map("updated_at") @db.Timestamptz(6)

  @@map("installation")
}

model User {
  id              String    @id @db.Uuid
  name            String
  emailNormalized String    @unique @map("email_normalized")
  passwordHash    String    @map("password_hash")
  role            String
  status          String
  sessionVersion  Int       @map("session_version")
  createdBy       String?   @map("created_by") @db.Uuid
  disabledBy      String?   @map("disabled_by") @db.Uuid
  disabledAt      DateTime? @map("disabled_at") @db.Timestamptz(6)
  createdAt       DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @map("updated_at") @db.Timestamptz(6)

  @@map("users")
}

model Material {
  id             String   @id @db.Uuid
  code           String
  normalizedCode String   @unique @map("normalized_code")
  name           String
  description    String?
  baseUnit       String   @map("base_unit")
  minimumStock   Decimal  @map("minimum_stock") @db.Decimal(18, 6)
  status         String
  version        Int
  createdBy      String   @map("created_by") @db.Uuid
  updatedBy      String   @map("updated_by") @db.Uuid
  createdAt      DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @map("updated_at") @db.Timestamptz(6)

  @@map("materials")
}

model Customer {
  id                    String   @id @db.Uuid
  type                  String
  displayName           String   @map("display_name")
  normalizedDisplayName String   @map("normalized_display_name")
  businessName          String?  @map("business_name")
  email                 String?
  phone                 String?
  operationalNote       String?  @map("operational_note")
  status                String
  version               Int
  createdBy             String   @map("created_by") @db.Uuid
  updatedBy             String   @map("updated_by") @db.Uuid
  createdAt             DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @map("updated_at") @db.Timestamptz(6)
  billingDocumentCiphertext Bytes? @map("billing_document_ciphertext")
  billingDocumentNonce      Bytes? @map("billing_document_nonce")
  billingDocumentAuthTag    Bytes? @map("billing_document_auth_tag")
  billingDocumentHash       String? @unique @map("billing_document_hash") @db.Char(64)
  billingDocumentLast4      String? @map("billing_document_last4") @db.VarChar(4)

  @@map("customers")
}

model DepositPolicy {
  id                 String    @id @db.Uuid
  versionNumber      Int       @unique @map("version_number")
  status             String
  mode               String
  rateBps            Int?      @map("rate_bps")
  minimumAmountCents BigInt?   @map("minimum_amount_cents")
  fixedAmountCents   BigInt?   @map("fixed_amount_cents")
  allowAboveTotal    Boolean   @map("allow_above_total")
  effectiveAt        DateTime  @map("effective_at") @db.Timestamptz(6)
  createdBy          String    @map("created_by") @db.Uuid
  archivedAt         DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt          DateTime  @map("created_at") @db.Timestamptz(6)
  @@map("deposit_policies")
}

model Order {
  id                      String    @id @db.Uuid
  commercialNumber        String    @unique @map("commercial_number")
  quoteId                 String    @unique @map("quote_id") @db.Uuid
  customerId              String    @map("customer_id") @db.Uuid
  status                  String
  version                 Int
  quoteNumberSnapshot     String    @map("quote_number_snapshot")
  customerNameSnapshot    String    @map("customer_name_snapshot")
  totalAmountCents        BigInt    @map("total_amount_cents")
  depositPolicyId         String    @map("deposit_policy_id") @db.Uuid
  depositPolicyVersion    Int       @map("deposit_policy_version")
  depositMode             String    @map("deposit_mode")
  depositRateBps          Int?      @map("deposit_rate_bps")
  depositFixedAmountCents BigInt?   @map("deposit_fixed_amount_cents")
  depositAllowAboveTotal  Boolean   @map("deposit_allow_above_total")
  depositAmountCents      BigInt    @map("deposit_amount_cents")
  paidAmountCents         BigInt    @map("paid_amount_cents")
  currentArtworkVersionId String?   @map("current_artwork_version_id") @db.Uuid
  createdBy               String    @map("created_by") @db.Uuid
  cancelledBy             String?   @map("cancelled_by") @db.Uuid
  cancellationReason      String?   @map("cancellation_reason")
  cancelledAt             DateTime? @map("cancelled_at") @db.Timestamptz(6)
  createdAt               DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @map("updated_at") @db.Timestamptz(6)
  @@map("orders")
}

model OrderItem {
  id                    String   @id @db.Uuid
  orderId               String   @map("order_id") @db.Uuid
  quoteItemId           String   @map("quote_item_id") @db.Uuid
  displayOrder          Int      @map("display_order")
  productCode           String   @map("product_code")
  productName           String   @map("product_name")
  variantCode           String   @map("variant_code")
  variantName           String   @map("variant_name")
  techniqueCode         String   @map("technique_code")
  techniqueName         String   @map("technique_name")
  requestedQuantity     Decimal  @map("requested_quantity") @db.Decimal(18, 6)
  technicalSheetId      String   @map("technical_sheet_id") @db.Uuid
  technicalSheetVersion Int      @map("technical_sheet_version")
  createdAt             DateTime @map("created_at") @db.Timestamptz(6)
  @@unique([orderId, quoteItemId])
  @@map("order_items")
}

model OrderMaterialRequirement {
  id               String   @id @db.Uuid
  orderId          String   @map("order_id") @db.Uuid
  orderItemId      String   @map("order_item_id") @db.Uuid
  materialId       String   @map("material_id") @db.Uuid
  materialCode     String   @map("material_code")
  materialName     String   @map("material_name")
  unit             String
  requiredQuantity Decimal  @map("required_quantity") @db.Decimal(18, 6)
  createdAt        DateTime @map("created_at") @db.Timestamptz(6)
  @@unique([orderItemId, materialId])
  @@map("order_material_requirements")
}

model PaymentCharge {
  id                String   @id @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  provider          String
  environment       String
  externalChargeId  String?  @map("external_charge_id")
  status            String
  billingType       String   @map("billing_type")
  amountCents       BigInt   @map("amount_cents")
  dueDate           DateTime @map("due_date") @db.Date
  invoiceUrl        String?  @map("invoice_url")
  externalReference String   @map("external_reference")
  feePolicyId       String?  @map("fee_policy_id") @db.Uuid
  feePolicyVersion  Int?     @map("fee_policy_version")
  feeSnapshotId     String?  @map("fee_snapshot_id") @db.Uuid
  feeStrategy       String?  @map("fee_strategy")
  estimatedFeeCents BigInt?  @map("estimated_fee_cents")
  estimatedNetCents BigInt?  @map("estimated_net_cents")
  providerLastEventAt DateTime? @map("provider_last_event_at") @db.Timestamptz(6)
  version           Int
  createdBy         String   @map("created_by") @db.Uuid
  createdAt         DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @map("updated_at") @db.Timestamptz(6)
  @@map("payment_charges")
}

model ArtworkVersion {
  id                            String    @id @db.Uuid
  orderId                       String    @map("order_id") @db.Uuid
  versionNumber                 Int       @map("version_number")
  fileId                        String    @unique @map("file_id") @db.Uuid
  status                        String
  customerConfirmationReference String?   @map("customer_confirmation_reference")
  customerConfirmedAt           DateTime? @map("customer_confirmed_at") @db.Timestamptz(6)
  customerConfirmedBy           String?   @map("customer_confirmed_by") @db.Uuid
  approvalRequestedAt           DateTime? @map("approval_requested_at") @db.Timestamptz(6)
  approvalRequestedBy           String?   @map("approval_requested_by") @db.Uuid
  rejectedAt                    DateTime? @map("rejected_at") @db.Timestamptz(6)
  rejectedBy                    String?   @map("rejected_by") @db.Uuid
  rejectionReason               String?   @map("rejection_reason")
  rejectionConfirmationSource   String?   @map("rejection_confirmation_source")
  createdBy                     String    @map("created_by") @db.Uuid
  createdAt                     DateTime  @map("created_at") @db.Timestamptz(6)
  @@unique([orderId, versionNumber])
  @@map("artwork_versions")
}

model AsaasConnection {
  id                    String    @id @db.Uuid
  environment           String
  status                String
  apiKeyCiphertext      Bytes?    @map("api_key_ciphertext")
  apiKeyNonce           Bytes?    @map("api_key_nonce")
  apiKeyAuthTag         Bytes?    @map("api_key_auth_tag")
  webhookTokenCiphertext Bytes?   @map("webhook_token_ciphertext")
  webhookTokenNonce     Bytes?    @map("webhook_token_nonce")
  webhookTokenAuthTag   Bytes?    @map("webhook_token_auth_tag")
  webhookPublicUrl      String    @map("webhook_public_url")
  keyFingerprint        String    @map("key_fingerprint") @db.Char(12)
  externalWebhookId     String?   @map("external_webhook_id")
  notificationEmailCiphertext Bytes? @map("notification_email_ciphertext")
  notificationEmailNonce Bytes? @map("notification_email_nonce")
  notificationEmailAuthTag Bytes? @map("notification_email_auth_tag")
  notificationEmailMasked String? @map("notification_email_masked")
  webhookSendType       String    @map("webhook_send_type")
  webhookApiVersion     Int       @map("webhook_api_version")
  webhookEvents         Json      @map("webhook_events")
  webhookStatus         String    @map("webhook_status")
  lastValidatedAt       DateTime? @map("last_validated_at") @db.Timestamptz(6)
  lastSuccessAt         DateTime? @map("last_success_at") @db.Timestamptz(6)
  lastFailureCategory   String?   @map("last_failure_category")
  lastEventReceivedAt   DateTime? @map("last_event_received_at") @db.Timestamptz(6)
  disconnectedAt        DateTime? @map("disconnected_at") @db.Timestamptz(6)
  lastErrorCode         String?   @map("last_error_code")
  version               Int
  createdBy             String    @map("created_by") @db.Uuid
  updatedBy             String    @map("updated_by") @db.Uuid
  createdAt             DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @map("updated_at") @db.Timestamptz(6)
  @@map("asaas_connections")
}

model AsaasPaymentMethod {
  id            String   @id @db.Uuid
  connectionId  String   @map("connection_id") @db.Uuid
  billingType   String   @map("billing_type")
  enabled       Boolean
  updatedBy     String   @map("updated_by") @db.Uuid
  updatedAt     DateTime @map("updated_at") @db.Timestamptz(6)
  @@unique([connectionId, billingType])
  @@map("asaas_payment_methods")
}

model AsaasFeeSnapshot {
  id               String    @id @db.Uuid
  connectionId     String    @map("connection_id") @db.Uuid
  environment      String
  status           String
  fetchedAt        DateTime? @map("fetched_at") @db.Timestamptz(6)
  sanitizedPayload Json      @map("sanitized_payload")
  errorCode        String?   @map("error_code")
  createdBy        String?   @map("created_by") @db.Uuid
  createdAt        DateTime  @map("created_at") @db.Timestamptz(6)
  @@map("asaas_fee_snapshots")
}

model PaymentFeePolicy {
  id             String    @id @db.Uuid
  versionNumber  Int       @unique @map("version_number")
  status         String
  feeSnapshotId  String    @map("fee_snapshot_id") @db.Uuid
  effectiveAt    DateTime  @map("effective_at") @db.Timestamptz(6)
  createdBy      String    @map("created_by") @db.Uuid
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt      DateTime  @map("created_at") @db.Timestamptz(6)
  @@map("payment_fee_policies")
}

model InventoryReservation {
  id                 String    @id @db.Uuid
  orderId            String    @map("order_id") @db.Uuid
  materialId         String    @map("material_id") @db.Uuid
  requiredQuantity   Decimal   @map("required_quantity") @db.Decimal(18, 6)
  reservedQuantity   Decimal   @map("reserved_quantity") @db.Decimal(18, 6)
  status             String
  exceptionConfirmed Boolean   @map("exception_confirmed")
  exceptionReason    String?   @map("exception_reason")
  createdBy          String    @map("created_by") @db.Uuid
  releasedBy         String?   @map("released_by") @db.Uuid
  createdAt          DateTime  @map("created_at") @db.Timestamptz(6)
  releasedAt         DateTime? @map("released_at") @db.Timestamptz(6)
  @@unique([orderId, materialId])
  @@map("inventory_reservations")
}

model Product {
  id             String   @id @db.Uuid
  code           String
  normalizedCode String   @unique @map("normalized_code")
  name           String
  description    String?
  status         String
  version        Int
  createdBy      String   @map("created_by") @db.Uuid
  updatedBy      String   @map("updated_by") @db.Uuid
  createdAt      DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @map("updated_at") @db.Timestamptz(6)

  @@map("products")
}

model ProductVariant {
  id             String   @id @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  code           String
  normalizedCode String   @map("normalized_code")
  name           String
  description    String?
  status         String
  version        Int
  createdBy      String   @map("created_by") @db.Uuid
  updatedBy      String   @map("updated_by") @db.Uuid
  createdAt      DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @map("updated_at") @db.Timestamptz(6)

  @@unique([productId, normalizedCode])
  @@map("product_variants")
}

model CustomizationTechnique {
  id             String   @id @db.Uuid
  code           String
  normalizedCode String   @unique @map("normalized_code")
  name           String
  description    String?
  status         String
  version        Int
  createdBy      String   @map("created_by") @db.Uuid
  updatedBy      String   @map("updated_by") @db.Uuid
  createdAt      DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @map("updated_at") @db.Timestamptz(6)

  @@map("customization_techniques")
}

model CatalogCombination {
  id          String   @id @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  variantId   String   @map("variant_id") @db.Uuid
  techniqueId String   @map("technique_id") @db.Uuid
  status      String
  version     Int
  createdBy   String   @map("created_by") @db.Uuid
  updatedBy   String   @map("updated_by") @db.Uuid
  createdAt   DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @map("updated_at") @db.Timestamptz(6)

  @@unique([productId, variantId, techniqueId])
  @@map("catalog_combinations")
}

model TechnicalSheet {
  id              String    @id @db.Uuid
  combinationId   String    @map("combination_id") @db.Uuid
  versionNumber   Int       @map("version_number")
  recordVersion   Int       @map("record_version")
  status          String
  yieldQuantity   Decimal   @map("yield_quantity") @db.Decimal(18, 6)
  lossBps         Int       @map("loss_bps")
  technicalNote   String?   @map("technical_note")
  previousSheetId String?   @map("previous_sheet_id") @db.Uuid
  createdBy       String    @map("created_by") @db.Uuid
  activatedBy     String?   @map("activated_by") @db.Uuid
  activatedAt     DateTime? @map("activated_at") @db.Timestamptz(6)
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt       DateTime  @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @map("updated_at") @db.Timestamptz(6)

  @@unique([combinationId, versionNumber])
  @@map("technical_sheets")
}

model TechnicalSheetComponent {
  id               String   @id @db.Uuid
  technicalSheetId String   @map("technical_sheet_id") @db.Uuid
  materialId       String   @map("material_id") @db.Uuid
  quantity         Decimal  @db.Decimal(18, 6)
  unit             String
  displayOrder     Int      @map("display_order")
  createdAt        DateTime @map("created_at") @db.Timestamptz(6)

  @@unique([technicalSheetId, materialId])
  @@map("technical_sheet_components")
}

model PricingPolicy {
  id            String    @id @db.Uuid
  versionNumber Int       @unique @map("version_number")
  status        String
  method        String
  rateBps       Int       @map("rate_bps")
  effectiveAt   DateTime  @map("effective_at") @db.Timestamptz(6)
  createdBy     String    @map("created_by") @db.Uuid
  archivedAt    DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt     DateTime  @map("created_at") @db.Timestamptz(6)

  @@map("pricing_policies")
}

model DiscountPolicy {
  id               String   @id @db.Uuid
  pricingPolicyId  String   @unique @map("pricing_policy_id") @db.Uuid
  employeeLimitBps Int      @map("employee_limit_bps")
  managerLimitBps  Int      @map("manager_limit_bps")
  status           String
  effectiveAt      DateTime @map("effective_at") @db.Timestamptz(6)
  createdBy        String   @map("created_by") @db.Uuid
  createdAt        DateTime @map("created_at") @db.Timestamptz(6)

  @@map("discount_policies")
}

model DiscountPolicyOption {
  id               String   @id @db.Uuid
  discountPolicyId String   @map("discount_policy_id") @db.Uuid
  discountBps      Int      @map("discount_bps")
  displayOrder     Int      @map("display_order")
  createdAt        DateTime @map("created_at") @db.Timestamptz(6)

  @@unique([discountPolicyId, discountBps])
  @@unique([discountPolicyId, displayOrder])
  @@map("discount_policy_options")
}

model PricingComponent {
  id                String   @id @db.Uuid
  pricingPolicyId   String   @map("pricing_policy_id") @db.Uuid
  name              String
  type              String
  amountCents       BigInt?  @map("amount_cents")
  rateBps           Int?     @map("rate_bps")
  status            String
  displayOrder      Int      @map("display_order")
  includeInCostBase Boolean  @map("include_in_cost_base")
  createdBy         String   @map("created_by") @db.Uuid
  createdAt         DateTime @map("created_at") @db.Timestamptz(6)

  @@map("pricing_components")
}

