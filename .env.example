NODE_ENV=development
DATABASE_URL=postgresql://north:north_dev_only@localhost:5432/north?schema=public
# Banco dedicado e allowlisted para testes destrutivos. Nunca use o banco north aqui.
TEST_DATABASE_URL=postgresql://north:north_dev_only@localhost:5432/north_test?schema=public
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
E2E_WEB_PORT=3100
E2E_API_PORT=3101
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=60000

# Segredos do Sprint 003. Gere 32 bytes aleatórios em base64; nunca commite o valor real.
NORTH_SECRET_MASTER_KEY=
# Diretório privado para artes. Em produção, monte um volume fora da imagem da aplicação.
OBJECT_STORAGE_ROOT=.north-private-files
ARTWORK_MAX_BYTES=26214400
WORKER_POLL_MS=2000

# Somente para homologação explícita; nunca use chave de produção.
ASAAS_ENVIRONMENT=SANDBOX
ASAAS_API_KEY=
ASAAS_WEBHOOK_AUTH_TOKEN=
ASAAS_WEBHOOK_PUBLIC_URL=

# Bootstrap: informe valores reais apenas no ambiente/CLI, nunca commite senhas.
BOOTSTRAP_COMPANY_NAME=Empresa de Demonstração
BOOTSTRAP_TIMEZONE=America/Manaus
BOOTSTRAP_MANAGER_NAME=Gestor de Demonstração
BOOTSTRAP_MANAGER_EMAIL=gestor@example.test
BOOTSTRAP_MANAGER_PASSWORD=change-me-in-local-env

