NODE_ENV=development
DATABASE_URL=postgresql://north:north_dev_only@localhost:5432/north?schema=public
# Banco dedicado e allowlisted para testes destrutivos. Nunca use o banco north aqui.
TEST_DATABASE_URL=postgresql://north:north_dev_only@localhost:5432/north_test?schema=public
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
E2E_WEB_PORT=3100
E2E_API_PORT=3101
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=60000

# Bootstrap: informe valores reais apenas no ambiente/CLI, nunca commite senhas.
BOOTSTRAP_COMPANY_NAME=Empresa de Demonstração
BOOTSTRAP_TIMEZONE=America/Manaus
BOOTSTRAP_MANAGER_NAME=Gestor de Demonstração
BOOTSTRAP_MANAGER_EMAIL=gestor@example.test
BOOTSTRAP_MANAGER_PASSWORD=change-me-in-local-env

